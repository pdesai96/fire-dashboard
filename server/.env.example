# Copy to .env on the Raspberry Pi and fill in. Never commit .env.

# --- Required ---
# From platform.openai.com > API keys. Stays on the Pi; never sent to the tablet or browser.
OPENAI_API_KEY=
# Admin console password (10+ characters). Leave empty to disable the console.
ADMIN_PASSWORD=

# --- Assistant ---
ASSISTANT_NAME=JARVIS
# How the assistant should address you (optional)
USER_NAME=
TIMEZONE=Europe/London
# Default location for weather (decimal degrees). Find yours on maps.google.com.
HOME_NAME=Manchester
HOME_LAT=53.4808
HOME_LON=-2.2426

# --- Model ---
# Any Responses API model your key can use. Checked at startup (see System tab).
OPENAI_MODEL=gpt-6-luna
# Optional: minimal | low | medium | high. Only set this for reasoning models that accept it.
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=1200
# Prices per million tokens, for the spend meter. Update if you change model.
OPENAI_PRICE_INPUT_PER_M=0.10
OPENAI_PRICE_CACHED_INPUT_PER_M=0.01
OPENAI_PRICE_OUTPUT_PER_M=0.50
# Hard stop for model calls once this month's estimated spend reaches this (0 = no cap).
MONTHLY_BUDGET_USD=5

# --- Behaviour ---
# Short-term chat history for follow-ups, deleted after this many idle hours.
CONVERSATION_RETENTION_HOURS=24
HISTORY_MESSAGES=20
MAX_AGENT_STEPS=6
PENDING_ACTION_MINUTES=5

# --- Server ---
PORT=8787
